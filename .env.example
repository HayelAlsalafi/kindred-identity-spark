# Safe local-development template. Never commit real credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/ccna
CORS_ORIGIN=http://localhost:5173

# Clerk authentication (required for the web app to start and for
# authenticated API calls). Get both values from the Clerk dashboard:
# https://dashboard.clerk.com -> your application -> API Keys.
# Use the "Development" instance keys while developing.
#
# Server-side secret key (Express API, @clerk/express):
CLERK_SECRET_KEY=sk_test_xxxxxxxxx
# Publishable key, shared by the API server (clerkMiddleware) and the
# Vite web app (ClerkProvider). The web app reads the VITE_ prefixed copy:
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxx
# Optional: only needed in production when Clerk is served through the
# built-in proxy at /api/__clerk (see clerkProxyMiddleware). Leave unset
# in local development.
# VITE_CLERK_PROXY_URL=https://your-domain/api/__clerk

# Planned for the image-storage phase:
# STORAGE_PROVIDER=local
# STORAGE_BUCKET=ccna-question-images
